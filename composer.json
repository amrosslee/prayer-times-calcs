{
    "name": "amrosslee/global-prayer-times",
    "description": "Offline, framework-independent Islamic prayer-time calculations",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "adhan",
        "islam",
        "prayer-times",
        "salat"
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "GlobalPrayerTimes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlobalPrayerTimes\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.89"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "style": "php-cs-fixer fix --dry-run --diff --allow-risky=no"
    },
    "config": {
        "sort-packages": true,
        "platform-check": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
